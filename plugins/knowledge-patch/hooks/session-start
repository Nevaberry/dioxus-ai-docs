#!/usr/bin/env bash
# Optional SessionStart hook. Detection is ephemeral and always fails open.

set -uo pipefail

fallback='{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Use knowledge-patch:using-knowledge-patch. Read matching patch bodies. Active patches: none."} }'

if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' "$fallback"
  exit 0
fi

hook_dir="$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)" || {
  printf '%s\n' "$fallback"
  exit 0
}
project_root="${CLAUDE_PROJECT_DIR:-$PWD}"
output="$(python3 "$hook_dir/detect.py" --root "$project_root" --hook 2>/dev/null)" || output=''

if [[ -n "$output" ]]; then
  printf '%s\n' "$output"
else
  printf '%s\n' "$fallback"
fi

exit 0
